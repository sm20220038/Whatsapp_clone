# Allow-list: everything is ignored except the source code listed below.
# Anything new at the top level stays private until it is added here on purpose.

/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/run-web.ps1
!/server/
!/tools/
!/web/

/server/*
!/server/whatsapp_server.erl
!/server/whatsapp_web.erl

/tools/*
!/tools/make-cert.mjs
!/tools/smoke-test.mjs
!/tools/sql/

/web/*
!/web/backend-java/
!/web/frontend/

/web/backend-java/*
!/web/backend-java/pom.xml
!/web/backend-java/mvnw
!/web/backend-java/mvnw.cmd
!/web/backend-java/.mvn/
!/web/backend-java/src/

/web/frontend/*
!/web/frontend/index.html
!/web/frontend/package.json
!/web/frontend/package-lock.json
!/web/frontend/vite.config.js
!/web/frontend/src/

.idea/
*.iml
*.beam
erl_crash.dump
__pycache__/
.DS_Store
Thumbs.db
